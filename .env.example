# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in your own values.
#  `.env` is git-ignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── SAFETY ───────────────────────────────────────────────────────────────────
#  1 = paper (no orders ever sent).  0 = LIVE, real money, no confirmation.
PAPER_TRADING=1
#  1 = scan and alert only.  0 = full trading loop (size → order → monitor).
SCANNER_MODE=1

# ── Broker (Dhan) ────────────────────────────────────────────────────────────
#  https://dhanhq.co → My Profile → DhanHQ Trading APIs → Generate Token
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

#  Optional: TOTP auto-login — mints a fresh token on every run.
DHAN_PIN=
DHAN_TOTP_SECRET=

# ── Sizing ───────────────────────────────────────────────────────────────────
DEPLOYED_CAPITAL=50000
ENABLE_SHORT_TRADES=1
TRACK_OPENING_RANGE=1

# ── Telegram alerts (optional) ───────────────────────────────────────────────
#  BOT_TOKEN from @BotFather; CHAT_ID from
#  https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_ID=

# ── Copy trading (optional) ──────────────────────────────────────────────────
#  Mirrors every entry/exit onto follower accounts, each sized off its OWN
#  capital. Full account credentials — keep them here, never in config.py.
COPY_TRADING_ENABLED=0
# FOLLOWER_ACCOUNTS=[{"name":"Account 2","client_id":"","pin":"","totp_secret":"","deployed_capital":100000,"leverage":5,"enabled":true}]
